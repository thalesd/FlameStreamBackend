// Base configuration INSIDE the container. The Dockerfile copies this over appsettings.json in
// the final image, because the checked-in appsettings.json is Windows-specific (D:\ roots, a cert
// path under the Windows user profile, AMF/DXVA2 encoding).
//
// This is only the base layer: docker-compose.yml can override any key with the usual
// double-underscore env vars, e.g. Server__Hls__SegmentSeconds or Kestrel__Endpoints__Https__Url.
// (The ASP.NET JSON config provider skips comments, so these are safe here.)
{
  "Server": {
    // Mount points, not host paths — see the volumes in docker-compose.yml.
    "LibraryRoot": "/media",
    "CacheRoot": "/cache",
    "AppReleasesRoot": "/app-releases",
    "Hls": {
      "SegmentSeconds": 4,
      // MUST stay None here: "Amd" means "-hwaccel dxva2 -c:v h264_amf", both Windows-only, and
      // WSL2 has no /dev/dri render node to offer VAAPI instead. This is CPU x264 encoding —
      // see the concurrency note in docker-compose.yml.
      "HardwareAcceleration": "None"
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://0.0.0.0:5000" }
      // No HTTPS endpoint by default, so the container boots with nothing mounted. Chromecast
      // and the native apps do need TLS: uncomment the cert mount + Kestrel__ env vars in
      // docker-compose.yml to add https://0.0.0.0:5001 on top of this.
    }
  }
}
