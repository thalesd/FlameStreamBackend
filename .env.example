# Copy to .env (same folder as docker-compose.yml) and fill in. Only the `tls` profile needs the
# GoDaddy values; `docker compose up` without that profile ignores everything here except TZ.
#
#   cp .env.example .env
#
# .env is gitignored — keep the real secrets out of the repo.

# Contact address on the Let's Encrypt account (expiry warnings go here).
ACME_EMAIL=thales.doni.ol@gmail.com

# Hostname Traefik routes and requests the certificate for.
FLAMESTREAM_HOST=flamestream.tdonsoft.com

# GoDaddy API credentials for the DNS-01 challenge — the same pair Posh-ACME uses on Windows
# (stored in pluginargs.json under the Posh-ACME order folder). Create/rotate them at
# https://developer.godaddy.com/keys — the key needs write access to the tdonsoft.com zone.
GODADDY_API_KEY=
GODADDY_API_SECRET=

TZ=America/Sao_Paulo
